# pyenv
#   For a library or package, you might want to ignore these files since the setup is personal.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, if you choose to ignore it, uncomment the following line:
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   However, if you choose to ignore it, uncomment the following line:
#poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
# .pdm-plugins.toml
# .pdm-python

# PEP 582 spaces
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat-pid

# SageMath parsed files
*.sage.py

